# Copier ce fichier en .env.local (jamais commité) et remplir les valeurs.
# Où les trouver : Supabase > Project Settings > API.

# URL du projet Supabase, ex. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique « anon » (peut être exposée au navigateur : la sécurité repose sur la RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé « service_role » : UNIQUEMENT côté serveur (scrapers, GitHub Actions).
# Ne jamais la préfixer par NEXT_PUBLIC_ ni la mettre dans le navigateur.
SUPABASE_SERVICE_ROLE_KEY=
